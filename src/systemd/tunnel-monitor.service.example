[Unit]
Description=DVI Bridge Tunnel Monitor
After=cloudflared.service
Requires=cloudflared.service
PartOf=cloudflared.service

[Service]
Type=simple
ExecStart=/usr/local/bin/monitor-tunnel.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# User/Group
User=root
Group=root

# Working directory
WorkingDirectory=/var/run/dvi-bridge

[Install]
WantedBy=multi-user.target
