[Unit]
Description=DVI Bridge Cloudflare Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dviha
ExecStart=/usr/local/bin/cloudflared tunnel run --config /home/dviha/dvi-bridge/cloudflared/config.yml
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
