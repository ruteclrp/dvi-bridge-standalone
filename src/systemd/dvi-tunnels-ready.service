[Unit]
Description=Wait for DVI tunnel services to become active
After=network-online.target dvi-tunnel.service device-channel.service
Wants=network-online.target dvi-tunnel.service device-channel.service

[Service]
Type=oneshot
User=root
ExecStart=/home/dviha/dvi-bridge/venv/bin/python /home/dviha/dvi-bridge/sidecar/wait_for_tunnels.py --timeout 120 --interval 3
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
