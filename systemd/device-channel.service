[Unit]
Description=Device Channel Client (WebSocket bridge to backend)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/pi/dvi-bridge-standalone/src/sidecar
ExecStart=/usr/bin/python3 device_channel.py
Restart=always
EnvironmentFile=/home/pi/dvi-bridge-standalone/.env

[Install]
WantedBy=multi-user.target
